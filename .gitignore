# Python environments (recreate with ./setup.sh)
.venv/
.venv-*/
__pycache__/
*.pyc

# Downloaded models (./setup.sh fetches them)
voices/*.onnx
voices/*.onnx.json
voices/*.bin

# Firmware build tree and personal device backup
firmware/WLED/
firmware/backup/
firmware/*.wav

# Scratch audio; only the demo clip is kept
samples/*.wav
!samples/jim_demo.wav
!samples/chris_demo.wav

# CAD environment
.venv-cad/

# Pre-rendered greeting audio
cache/

# This machine's settings (copy jim.example.toml)
jim.toml

# Recorded visits (kids' voices and camera frames): never committed
recordings/

# Extra Jims: settings set aside when removed, and their recordings
jims/*.removed
recordings-*/
