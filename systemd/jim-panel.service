[Unit]
Description=Jim-o-Lantern's control panel on 127.0.0.1:8790 (Jim himself runs only when started from it)
After=network.target

[Service]
WorkingDirectory=%h/claude/ledProject
ExecStart=%h/claude/ledProject/.venv/bin/python %h/claude/ledProject/jim_panel.py --port 8790
Environment=PYTHONUNBUFFERED=1
# stopping the panel stops Jim (he unloads his chat model on the way out)
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
